<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>fr.paris.lutece.starters</groupId>
        <artifactId>lutece-parent</artifactId>
        <version>8.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lutece-starter</artifactId>
    <name>Lutece Platform</name>
    <description>Lutece Platform</description>
    
    <properties>
        <maven.deploy.skip>${lutece.deploy.skip}</maven.deploy.skip>
        <componentName>lutece-starter</componentName>
    </properties>

    <dependencies>
          
            <!-- Forms starter -->
            <dependency>
                <groupId>fr.paris.lutece.starters</groupId>
			    <artifactId>forms-starter</artifactId>
                <version>${lutece.forms-starter.version}</version>
            </dependency>
            
            <!-- Appointment starter -->
            <dependency>
                <groupId>fr.paris.lutece.starters</groupId>
			    <artifactId>appointment-starter</artifactId>
                <version>${lutece.appointment-starter.version}</version>
            </dependency>
            
            <!-- Editorial starter -->
            <dependency>
                <groupId>fr.paris.lutece.starters</groupId>
			    <artifactId>editorial-starter</artifactId>
                <version>${lutece.editorial-starter.version}</version>
            </dependency>
            
            <!-- others plugins not included in the starters forms, appointment , editorial-->
            
            <!--Authentification Plugins-->
			<dependency>
				<groupId>fr.paris.lutece.plugins</groupId>
				<artifactId>plugin-mylutece</artifactId>
				<version>${lutece.plugin-mylutece.version}</version>
				<type>lutece-plugin</type>
			</dependency>
			<dependency>
				<groupId>fr.paris.lutece.plugins</groupId>
				<artifactId>module-mylutece-database</artifactId>
				<version>${lutece.module-mylutece-database.version}</version>
				<type>lutece-plugin</type>
			</dependency>
		    <dependency>
				<groupId>fr.paris.lutece.plugins</groupId>
				<artifactId>plugin-adminauthenticationwsso</artifactId>
				<version>${lutece.plugin-adminauthenticationwsso.version}</version>
				<type>lutece-plugin</type>
			</dependency>
            
    </dependencies>
</project>