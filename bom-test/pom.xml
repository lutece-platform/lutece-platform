    <!-- No <version>: inherited from the parent. This module is never deployed,
         so it does not need a version of its own. -->
    <artifactId>lutece-bom-test</artifactId>
    <name>Lutece BOM consumer test</name>
    <description>
        Consumes lutece-bom the way a downstream project does: imports it, then declares
        every managed artifact WITHOUT a version. Resolution fails if a managed entry is
        dead (artifactId typo, undefined version property) or points at a version that
        does not exist in the repositories. Nothing else validates that today.

        Dependencies are declared in provided scope on purpose: the global pom excludes
        that scope from requireUpperBoundDeps and dependencyConvergence, so this module
        reports resolution problems without drowning them in the transitive version
        conflicts of the whole platform.

        Regenerate the dependency list from lutece-bom whenever the BOM changes.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <componentName>lutece-bom-test</componentName>
    </properties>

