            <artifactId>plugin-childpages</artifactId>
            <version>${lutece.plugin-childpages.version}</version>
            <type>lutece-plugin</type>
        </dependency>
        <dependency>
            <groupId>fr.paris.lutece.plugins</groupId>
            <artifactId>plugin-quicklinks</artifactId>
            <version>${lutece.plugin-quicklinks.version}</version>
