            <artifactId>plugin-contact</artifactId>
            <version>${lutece.plugin-contact.version}</version>
            <type>lutece-plugin</type>
        </dependency>
        <dependency>
            <groupId>fr.paris.lutece.plugins</groupId>
            <artifactId>plugin-pagelinkservice</artifactId>
            <version>${lutece.plugin-pagelinkservice.version}</version>
            <type>lutece-plugin</type>
        </dependency>

